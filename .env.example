# Server-only PostgreSQL URLs. Never prefix these with NEXT_PUBLIC_.
DATABASE_URL="postgresql://APP_USER:APP_PASSWORD@HOST:5432/DATABASE?sslmode=require"
SHADOW_DATABASE_URL="postgresql://MIGRATION_USER:MIGRATION_PASSWORD@HOST:5432/SHADOW_DATABASE?sslmode=require"

# Long random value used only to one-way hash rate-limit identities.
RATE_LIMIT_SALT="replace-with-at-least-32-random-characters"

# Public deployment URL; safe to expose because it contains no credential.
NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Optional public Google Analytics measurement ID (not an API secret).
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Optional server-read verification token issued by Google Search Console.
GOOGLE_SITE_VERIFICATION="replace-with-google-verification-token"
