generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(100)
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  currency     String        @default("NGN") @db.Char(3)
  timezone     String        @default("Africa/Lagos") @db.VarChar(64)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  sessions     Session[]

  @@map("users")
}

model Category {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  name         String          @db.VarChar(100)
  type         TransactionType
  color        String          @default("#64748B") @db.VarChar(7)
  icon         String          @default("tag") @db.VarChar(50)
  isDefault    Boolean         @default(false) @map("is_default")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, type])
  @@index([userId, type])
  @@map("categories")
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  categoryId      String          @map("category_id") @db.Uuid
  type            TransactionType
  amount          Decimal         @db.Decimal(14, 2)
  description     String          @db.VarChar(150)
  note            String?         @db.VarChar(500)
  transactionDate DateTime        @map("transaction_date") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, transactionDate])
  @@index([userId, type, transactionDate])
  @@index([categoryId])
  @@map("transactions")
}

model Budget {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  amount     Decimal  @db.Decimal(14, 2)
  month      Int      @db.SmallInt
  year       Int      @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, categoryId, year, month])
  @@index([userId, year, month])
  @@index([categoryId])
  @@map("budgets")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RateLimit {
  id           String    @id @default(uuid()) @db.Uuid
  keyHash      String    @map("key_hash") @db.Char(64)
  action       String    @db.VarChar(32)
  hitCount     Int       @default(1) @map("hit_count")
  windowStart  DateTime  @default(now()) @map("window_start")
  blockedUntil DateTime? @map("blocked_until")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([keyHash, action])
  @@index([windowStart])
  @@map("rate_limits")
}
